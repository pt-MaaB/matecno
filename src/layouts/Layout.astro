---
import { DEFAULT_LOCALE } from '../data/structure.mjs';

interface Alt { lang: string; htmlLang: string; href: string }
interface Ui {
  floatingWaAria: string; floatingWaMessage: string;
  cookieText: string; cookieAccept: string; cookieReject: string; cookieDialog: string;
  privacyLabel: string; privacyShort: string;
}
interface Props {
  title: string;
  description: string;
  lang: string;
  htmlLang: string;
  ogLocale: string;
  jsonld: unknown;
  alternates: Alt[];
  ui: Ui;
  /** Open Graph type; 'article' on blog posts. Every other page: 'website'. */
  ogType?: string;
}

const { title, description, lang, htmlLang, ogLocale, jsonld, alternates, ui, ogType = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const abs = (href: string) => new URL(href, Astro.site).href;
const xDefault = alternates.find((a) => a.lang === DEFAULT_LOCALE) ?? alternates[0];
const waHref = `https://wa.me/351919642845?text=${encodeURIComponent(ui.floatingWaMessage)}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- First-touch lead source (S19, pile-cmo_seo_geo-s19; consent gate 2026-11-21): the visit's first page (path),
         the site that sent the visitor (host only) and utm_source/medium/campaign, kept in sessionStorage (no cookie,
         gone when the tab closes) ONLY after "Aceitar" on the statistics cookies (privacidade §6, Lei 41/2004 art. 5:
         storing anything on the device needs consent unless strictly necessary), and only on the visit's first page.
         Sent only with a contact-form submission. Without consent the form reads the page before it at submit time,
         storing nothing (ContactPage.astro). Same field names as HoraCerta (web/lib/signupSource.ts). -->
    <script is:inline>
      (function () {
        var KEY = 'mt_entry_touch';
        window.__mtEntryTouch = function () {
          try {
            if (localStorage.getItem('mt_cookie_consent') !== 'granted' || sessionStorage.getItem(KEY)) return;
          } catch (e) { return; }
          var refHost = '';
          if (document.referrer) {
            try {
              var h = new URL(document.referrer).hostname;
              if (h === location.hostname) return;      // not the visit's first page: nothing to keep
              refHost = h.replace(/^www\./, '');
            } catch (e) {}
          }
          var params = new URLSearchParams(location.search);
          var entry = {
            entry_referrer: refHost,
            entry_landing: location.pathname,
            utm_source: (params.get('utm_source') || '').toLowerCase(),
            utm_medium: (params.get('utm_medium') || '').toLowerCase(),
            utm_campaign: (params.get('utm_campaign') || '').toLowerCase()
          };
          try { sessionStorage.setItem(KEY, JSON.stringify(entry)); } catch (e) {}
        };
        window.__mtEntryTouch();
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang alternates -->
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.htmlLang} href={abs(a.href)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(xDefault.href)} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    {alternates
      .filter((a) => a.lang !== lang)
      .map((a) => <meta property="og:locale:alternate" content={a.htmlLang.replace('-', '_')} />)}
    <meta property="og:site_name" content="Matecno" />
    {/* 2026-10-27: no og:image meant a shared link showed no picture; /og.png is also the JSON-LD `image` */}
    <meta property="og:image" content={abs('/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MATECNO: Software para PME em Coimbra" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={abs('/og.png')} />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Organisation JSON-LD Schema (ProfessionalService / SoftwareCompany) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

    <!-- Google Analytics loads ONLY after the visitor clicks "Aceitar" (cookie banner at the end of <body>, CEO 2026-11-12). -->
  </head>
  <body class="font-sans bg-white text-gray-900 antialiased">
    <slot />

    <!-- WhatsApp Floating Button -->
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={ui.floatingWaAria}
      class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-green-500 hover:bg-green-600 text-white rounded-full shadow-lg transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <!-- Privacy + cookie preferences, every page (bottom-left; WhatsApp is bottom-right) -->
    <div class="fixed bottom-2 left-3 z-40 rounded bg-white/80 px-2 py-1 text-[11px] text-gray-500 backdrop-blur">
      <a href="/privacidade" class="hover:text-gray-900 hover:underline">{ui.privacyShort}</a>
      <span aria-hidden="true">·</span>
      <button type="button" data-consent-open class="hover:text-gray-900 hover:underline">Cookies</button>
    </div>

    <!-- Cookie banner (CEO 2026-11-12): analytics only after "Aceitar"; "Recusar" is as easy as "Aceitar" -->
    <div
      id="mt-consent"
      hidden
      role="dialog"
      aria-label={ui.cookieDialog}
      class="fixed inset-x-3 bottom-10 z-[60] mx-auto max-w-lg rounded-xl border border-gray-200 bg-white p-4 text-sm text-gray-700 shadow-lg"
    >
      <p>
        {ui.cookieText}
        <a href="/privacidade" class="underline hover:text-gray-900">{ui.privacyLabel}</a>
      </p>
      <div class="mt-3 flex justify-end gap-2">
        <button type="button" data-consent="denied" class="rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-900 hover:bg-gray-50">{ui.cookieReject}</button>
        <button type="button" data-consent="granted" class="rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-900 hover:bg-gray-50">{ui.cookieAccept}</button>
      </div>
    </div>
    <script is:inline define:vars={{ GA_ID: 'G-JPCGLZP0QB' }}>
      (function () {
        var KEY = 'mt_cookie_consent';
        var box = document.getElementById('mt-consent');
        var loaded = false;
        function get() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
        function set(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
        function show() { if (box) box.hidden = false; }
        function hide() { if (box) box.hidden = true; }
        function loadGA() {
          if (loaded) return;
          loaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', GA_ID);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
        }
        function dropGaCookies() {
          document.cookie.split(';').forEach(function (c) {
            var n = c.split('=')[0].trim();
            if (n.indexOf('_ga') === 0) {
              document.cookie = n + '=; Max-Age=0; path=/';
              document.cookie = n + '=; Max-Age=0; path=/; domain=.matecno.pt';
            }
          });
        }
        var choice = get();
        if (choice === 'granted') loadGA();
        else {
          dropGaCookies();          // cookies left from before the banner (GA ran for everyone until 2026-11-12)
          try { sessionStorage.removeItem('mt_entry_touch'); } catch (e) {}   // kept before the 11-21 consent gate
          if (choice !== 'denied') show();
        }
        document.addEventListener('click', function (e) {
          var t = e.target && e.target.closest ? e.target.closest('[data-consent],[data-consent-open]') : null;
          if (!t) return;
          if (t.hasAttribute('data-consent-open')) { show(); return; }
          var v = t.getAttribute('data-consent');
          set(v);
          hide();
          if (v === 'granted') { if (window.__mtEntryTouch) window.__mtEntryTouch(); loadGA(); return; }
          try { sessionStorage.removeItem('mt_entry_touch'); } catch (e) {}
          dropGaCookies();
          if (loaded) location.reload();
        });
      })();
    </script>
  </body>
</html>
