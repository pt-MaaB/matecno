---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
}
const { title, description, href, icon } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col p-6 bg-white border border-gray-200 rounded-xl hover:border-brand hover:shadow-md transition-all"
>
  <span class="text-3xl mb-3">{icon}</span>
  <h3 class="font-semibold text-gray-900 group-hover:text-brand transition-colors mb-2">{title}</h3>
  <p class="text-sm text-gray-600 flex-1">{description}</p>
  <span class="mt-4 text-sm font-medium text-brand group-hover:underline">Saber mais →</span>
</a>
