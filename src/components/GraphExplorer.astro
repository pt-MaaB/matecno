---
// GraphExplorer.astro
// ---------------------------------------------------------------------------
// Production port of the locked V14 prototype (matecno-v14-dissect.html).
//
// PRESERVED EXACTLY (visuals + interactions):
//   - white background, 2s MATECNO intro fade
//   - ~60 colour-coded nodes converging on a dark MATECNO core
//   - hover a node -> traces its path UP the tree to core (animated token walk)
//   - click a hub -> dive + dissect (cluster isolates left, aspect cards
//     cascade in on the right, connector lines drawn to nodes)
//   - orbit (drag) + zoom (scroll)
//   - hand-placed layout (NO force-directed physics)
//
// PRODUCTION CHANGES:
//   - content-driven: reads a serialised JSON blob (#mtc-data) built from the
//     `content` prop; nothing about the graph is hardcoded in the script
//   - SEO/a11y safety-net rendered server-side: real <header> nav, an sr-only
//     <h1>+tagline+link list, and a <noscript> fallback. The canvas is
//     progressive enhancement layered on top.
//   - mobile: full-width detail panel < 760px, tap-to-dissect, legend hidden,
//     hover-path is desktop-only
//   - a11y: prefers-reduced-motion freezes intro/animation to the final state;
//     focus-visible styling on links/buttons
// ---------------------------------------------------------------------------

interface Aspect {
  label: string;
  title: string;
  items: string[];
}
interface HubPage {
  title: string;
  description: string;
  h1: string;
  paras: string[];
}
interface Hub {
  key: string;
  route: string;
  label: string;
  color: string;
  pos: [number, number, number];
  aspects: Aspect[];
  extra?: string[];
  page: HubPage;
}
interface Alt { lang: string; htmlLang: string; href: string; short: string; name: string }
interface Content {
  seo: { title: string; description: string; jsonld: Record<string, unknown> };
  core: { label: string; route: string; tagline: string };
  hubs: Hub[];
  colors?: Record<string, string>;
  ui?: Record<string, string>;
  lang?: string;
  alternates?: Alt[];
}

interface Props {
  content: Content;
}

import LangSwitcher from './LangSwitcher.astro';

const { content } = Astro.props;
const { core, hubs } = content;
const ui = content.ui ?? {};
const alternates = content.alternates ?? [];
const lang = content.lang ?? 'pt';
---

<div class="mtc-explorer" data-mtc-root>
  <!-- Serialised single source of truth. The client script reads THIS, not any hardcoded data. -->
  <script type="application/json" id="mtc-data" set:html={JSON.stringify(content)} is:inline></script>

  <!-- =====================================================================
       SAFETY-NET (always in server-rendered HTML — SEO + a11y).
       These are real links / real content so crawlers get the full link
       graph and no-JS / screen-reader users get a readable page.
       ===================================================================== -->

  <!-- Real navigation with real <a href> links -->
  <header class="mtc-nav" id="mtc-nav">
    <a class="mtc-logo" href={core.route} data-mtc-logo>{core.label}</a>
    <nav class="mtc-navlinks" aria-label={ui.navAria}>
      {hubs.map((h) => (
        <a href={h.route}>{h.label}</a>
      ))}
    </nav>
    <div class="mtc-navright">
      <div class="mtc-legend" aria-hidden="true">
        {hubs.map((h) => (
          <span><i style={`background:${h.color}`}></i>{h.label}</span>
        ))}
      </div>
      <LangSwitcher alternates={alternates} current={lang} />
    </div>
  </header>

  <!-- Visually-hidden content block: gives crawlers/AT the H1, tagline and a
       full link list to every page even though the visual layer is a canvas. -->
  <div class="sr-only">
    <h1>{content.seo.title}</h1>
    <p>{core.tagline}</p>
    <ul>
      {hubs.map((h) => (
        <li>
          <a href={h.route}>{h.page.h1}</a> — {h.page.description}
        </li>
      ))}
    </ul>
  </div>

  <!-- No-JS fallback: readable page + same links; hides the canvas. -->
  <noscript>
    <style>{`[data-mtc-root] #mtc-graph,[data-mtc-root] #mtc-links,[data-mtc-root] .mtc-hint,[data-mtc-root] .mtc-intro{display:none!important}[data-mtc-root] .mtc-fallback{display:block!important}`}</style>
    <div class="mtc-fallback">
      <h1>{content.seo.title}</h1>
      <p class="mtc-fallback-tag">{core.tagline}</p>
      <ul class="mtc-fallback-links">
        {hubs.map((h) => (
          <li>
            <a href={h.route}><strong>{h.page.h1}</strong></a>
            <span>{h.page.description}</span>
          </li>
        ))}
      </ul>
    </div>
  </noscript>

  <!-- =====================================================================
       PROGRESSIVE-ENHANCEMENT LAYER (the interactive graph).
       ===================================================================== -->
  <canvas id="mtc-graph"></canvas>
  <svg id="mtc-links" aria-hidden="true"></svg>

  <button class="mtc-back" id="mtc-back" type="button">← {ui.back}</button>
  <div class="mtc-hint" id="mtc-hint">{ui.hint}</div>
  <div class="mtc-intro" id="mtc-intro" aria-hidden="true">
    <div class="mtc-wordmark">MATE<span class="u">CNO</span></div>
  </div>
  <div class="mtc-detail" id="mtc-detail" role="dialog" aria-label={ui.detailLabel} aria-modal="false"></div>
</div>

<style is:global>
  /* Global (not scoped): the dissect panel + connector lines are injected via
     innerHTML at runtime, so they never receive Astro's scope hash. This
     component only renders on the homepage, and every selector below is
     namespaced (.mtc-* / .acard / #mtc-*), so global is safe and correct. */
  .mtc-explorer {
    --mtc-bg: #ffffff;
    --mtc-ink: #1b1b1e;
    --mtc-muted: #6a6a70;
    --mtc-dim: #a7a7a2;
    --mtc-sans: -apple-system, system-ui, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --mtc-mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
    position: fixed;
    inset: 0;
    background: var(--mtc-bg);
    color: var(--mtc-ink);
    font-family: var(--mtc-sans);
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }
  .mtc-explorer *,
  .mtc-explorer *::before,
  .mtc-explorer *::after {
    box-sizing: border-box;
  }

  #mtc-graph {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    z-index: 4;
    touch-action: none;
  }
  #mtc-graph.grab {
    cursor: grabbing;
  }
  #mtc-graph.point {
    cursor: pointer;
  }
  #mtc-links {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 8;
  }

  /* intro fade */
  .mtc-intro {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: var(--mtc-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.9s ease;
  }
  .mtc-intro.hide {
    opacity: 0;
    pointer-events: none;
  }
  .mtc-wordmark {
    font-weight: 500;
    font-size: clamp(22px, 4.4vw, 44px);
    letter-spacing: 0.42em;
    color: #26262a;
    padding-left: 0.42em;
    opacity: 0;
    animation: mtc-wm 1.2s ease 0.15s forwards;
  }
  @keyframes mtc-wm {
    from {
      opacity: 0;
      letter-spacing: 0.62em;
    }
    to {
      opacity: 1;
      letter-spacing: 0.42em;
    }
  }
  .mtc-wordmark .u {
    color: #a9a9a4;
  }

  /* nav / chrome */
  .mtc-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 14;
    display: flex;
    align-items: center;
    gap: 22px;
    padding: clamp(20px, 3.5vw, 32px) clamp(22px, 5vw, 52px);
    opacity: 0;
    transition: opacity 0.6s 0.3s;
  }
  .mtc-nav.show {
    opacity: 1;
  }
  .mtc-logo {
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.16em;
    color: var(--mtc-ink);
    cursor: pointer;
    text-decoration: none;
  }
  .mtc-navlinks {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .mtc-navlinks a {
    font-family: var(--mtc-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mtc-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .mtc-navlinks a:hover {
    color: var(--mtc-ink);
  }
  .mtc-navright {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 26px);
  }
  .mtc-legend {
    display: flex;
    gap: 16px;
    font-family: var(--mtc-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--mtc-muted);
  }
  .mtc-legend span {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .mtc-legend i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  /* With 6 hubs the colour legend + nav + switcher no longer fit together on
     narrower screens — drop the (redundant, nodes are labelled) legend below
     1440px so the bar never wraps mid-label. */
  @media (max-width: 1439px) {
    .mtc-legend {
      display: none;
    }
  }
  /* On small screens the mono nav links can crowd the logo — keep them but tighten. */
  @media (max-width: 520px) {
    .mtc-navlinks {
      gap: 12px;
    }
    .mtc-navlinks a {
      font-size: 10px;
      letter-spacing: 0.04em;
    }
  }

  .mtc-hint {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 20px;
    z-index: 12;
    text-align: center;
    font-family: var(--mtc-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mtc-dim);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s 0.5s;
    padding: 0 16px;
  }
  .mtc-hint.show {
    opacity: 1;
  }
  @media (max-width: 760px) {
    .mtc-hint {
      font-size: 9.5px;
      letter-spacing: 0.06em;
    }
  }

  /* dissect detail panel */
  .mtc-detail {
    --acc: #1b1b1e;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(46vw, 560px);
    z-index: 10;
    padding: clamp(80px, 12vh, 120px) clamp(28px, 4vw, 52px) 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    pointer-events: none;
    opacity: 0;
    transform: translateX(30px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .mtc-detail.open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .mtc-detail .dhead {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 2px;
  }
  .mtc-detail .dhead .k {
    font-family: var(--mtc-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .mtc-detail h2 {
    font-weight: 500;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--mtc-ink);
  }
  .mtc-detail .dkick {
    font-family: var(--mtc-mono);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mtc-dim);
    margin: 2px 0 0;
  }
  .mtc-detail .dmark {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 14px 0 20px;
  }
  .mtc-detail .dmark span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--acc);
  }
  .mtc-detail .dmark span:first-child {
    width: 34px;
  }
  .mtc-detail .dmark span:last-child {
    width: 18px;
  }
  .mtc-detail .dlink {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--acc) 55%, transparent);
    font-family: var(--mtc-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .mtc-detail .dlink:hover {
    background: color-mix(in srgb, var(--acc) 10%, transparent);
    transform: translateX(3px);
  }

  .acard {
    position: relative;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-top: 2px solid var(--acc);
    border-radius: 14px;
    padding: 20px 22px;
    box-shadow: 0 22px 50px -34px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.5s ease, transform 0.35s ease, box-shadow 0.35s ease;
  }
  .acard.in {
    opacity: 1;
    transform: none;
  }
  .acard.in:hover {
    transform: translateY(-3px);
    box-shadow: 0 28px 60px -32px rgba(0, 0, 0, 0.5);
  }
  .acard .num {
    font-family: var(--mtc-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--mtc-dim);
    margin: 0 0 11px;
    padding-bottom: 11px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .acard .num b {
    color: var(--acc);
    font-weight: 500;
  }
  .acard .num i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .acard h3 {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
    color: var(--mtc-ink);
  }
  .acard ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .acard li {
    font-size: 13px;
    color: var(--mtc-ink);
    background: color-mix(in srgb, var(--acc) 7%, #fff);
    border: 1px solid color-mix(in srgb, var(--acc) 22%, transparent);
    border-radius: 999px;
    padding: 5px 11px;
    transition: background 0.2s ease;
  }
  .acard li:hover {
    background: color-mix(in srgb, var(--acc) 14%, #fff);
  }
  .acard p {
    margin: 0;
    font-size: 14px;
    color: var(--mtc-muted);
    line-height: 1.55;
  }

  .mtc-back {
    position: fixed;
    top: 68px;
    left: clamp(22px, 5vw, 52px);
    z-index: 15;
    font-family: var(--mtc-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--mtc-muted);
    background: none;
    border: 0;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .mtc-back.show {
    opacity: 1;
    pointer-events: auto;
  }
  .mtc-back:hover {
    color: var(--mtc-ink);
  }

  /* MOBILE: full-width detail panel under 760px */
  @media (max-width: 760px) {
    .mtc-detail {
      width: 100%;
      padding: clamp(72px, 14vh, 110px) 20px 32px;
      background: linear-gradient(
        to right,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.86) 14%,
        rgba(255, 255, 255, 0.96) 100%
      );
      backdrop-filter: blur(2px);
    }
    .mtc-back {
      top: clamp(18px, 3vw, 26px);
    }
  }

  /* focus-visible for keyboard users */
  .mtc-explorer a:focus-visible,
  .mtc-explorer button:focus-visible {
    outline: 2px solid var(--mtc-ink);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* sr-only (visually hidden but read by AT / crawlers) */
  .mtc-explorer .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* no-JS fallback (revealed by the <noscript> <style> above) */
  .mtc-fallback {
    display: none;
    position: relative;
    z-index: 40;
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(90px, 16vh, 140px) 24px 60px;
  }
  .mtc-fallback h1 {
    font-weight: 500;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .mtc-fallback-tag {
    color: var(--mtc-muted);
    font-size: 1.05rem;
    margin: 0 0 28px;
  }
  .mtc-fallback-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .mtc-fallback-links li {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .mtc-fallback-links a {
    color: var(--mtc-ink);
    text-decoration: none;
    font-size: 1.1rem;
  }
  .mtc-fallback-links a:hover {
    text-decoration: underline;
  }
  .mtc-fallback-links span {
    color: var(--mtc-muted);
    font-size: 0.95rem;
  }

  /* prefers-reduced-motion: freeze intro/animation to the final state */
  @media (prefers-reduced-motion: reduce) {
    .mtc-wordmark {
      animation: none;
      opacity: 1;
    }
    .mtc-intro {
      transition: none;
    }
    .mtc-nav,
    .mtc-hint {
      transition: none;
    }
    .mtc-detail,
    .acard,
    .mtc-back {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-mtc-root]');
    if (!root) return;
    var dataEl = document.getElementById('mtc-data');
    if (!dataEl) return;
    var DATA;
    try {
      DATA = JSON.parse(dataEl.textContent || '{}');
    } catch (e) {
      return;
    }
    var HUBS_DATA = DATA.hubs || [];
    var CORE_LABEL = (DATA.core && DATA.core.label) || 'MATECNO';
    var UI = DATA.ui || {};

    var reduce =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var isTouch =
      window.matchMedia && window.matchMedia('(hover: none), (pointer: coarse)').matches;

    var canvas = document.getElementById('mtc-graph'),
      ctx = canvas.getContext('2d'),
      links = document.getElementById('mtc-links');
    var W = 0,
      H = 0,
      DPR = Math.min(window.devicePixelRatio || 1, 2),
      cx = 0,
      cy = 0;

    // deterministic PRNG — same seed as V14 so the hand-placed jitter is identical
    var _s = 4242;
    function rnd() {
      _s = (_s * 1664525 + 1013904223) % 4294967296;
      return _s / 4294967296;
    }

    // hex -> "r,g,b" for rgba() strings
    function hexToRgb(hex) {
      var h = (hex || '#1b1b1e').replace('#', '');
      if (h.length === 3)
        h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
      var n = parseInt(h, 16);
      return ((n >> 16) & 255) + ',' + ((n >> 8) & 255) + ',' + (n & 255);
    }

    // Build COL (rgb strings) + HEX maps keyed by hub.key, from the content data.
    var COL = { core: '27,27,30' },
      HEX = { core: '#1b1b1e' };
    HUBS_DATA.forEach(function (h) {
      COL[h.key] = hexToRgb(h.color);
      HEX[h.key] = h.color;
    });

    // -----------------------------------------------------------------------
    // Graph construction (ported from V14, now driven by DATA)
    // -----------------------------------------------------------------------
    var nodes = [],
      edges = [],
      adj = {};
    function add(x, y, z, kind, group, label, hubId) {
      var n = {
        x: x,
        y: y,
        z: z,
        kind: kind,
        group: group,
        label: label || '',
        hubId: hubId == null ? -1 : hubId,
        parent: -1,
      };
      nodes.push(n);
      return nodes.length - 1;
    }
    function link(a, b, g) {
      edges.push({ a: a, b: b, g: g });
      (adj[a] = adj[a] || []).push(b);
      (adj[b] = adj[b] || []).push(a);
      nodes[b].parent = a;
    }
    function around(p, r) {
      var u = rnd() * 2 - 1,
        th = rnd() * 6.283,
        s = Math.sqrt(1 - u * u);
      return [
        p[0] + r * s * Math.cos(th),
        p[1] + r * u,
        p[2] + r * s * Math.sin(th),
      ];
    }

    var core = add(0, 0, 0, 'core', 'core', CORE_LABEL, -1);
    var HUBS = [];
    HUBS_DATA.forEach(function (h, hidx) {
      var p = h.pos;
      var hi = add(p[0], p[1], p[2], 'hub', h.key, h.label, hidx);
      link(core, hi, h.key);
      var Hobj = { idx: hi, g: h.key, key: h.key, label: h.label, route: h.route, aspects: [] };
      (h.aspects || []).forEach(function (asp) {
        // aspect label becomes a primary satellite node
        var sp = around(p, 1.2 + rnd() * 0.4);
        var si = add(sp[0], sp[1], sp[2], 'sat', h.key, asp.label, hidx);
        link(hi, si, h.key);
        var aspectCopy = { label: asp.label, title: asp.title, items: asp.items || [], node: si };
        Hobj.aspects.push(aspectCopy);
        // density: a few sub-nodes, and derive extra density from aspect.items
        var itemPool = (asp.items || []).slice();
        var nsub = 1 + ((rnd() * 2) | 0);
        for (var s = 0; s < nsub; s++) {
          var bp = around(sp, 0.5 + rnd() * 0.25);
          var lbl = itemPool.length ? String(itemPool[s % itemPool.length]) : '';
          add(bp[0], bp[1], bp[2], 'sub', h.key, '', hidx);
          link(si, nodes.length - 1, h.key);
        }
      });
      // extra satellite nodes for density (from data.hubs[].extra)
      (h.extra || []).forEach(function (name) {
        var sp = around(p, 1.15 + rnd() * 0.5);
        var si = add(sp[0], sp[1], sp[2], 'sat', h.key, name, hidx);
        link(hi, si, h.key);
        if (rnd() < 0.5) {
          var bp = around(sp, 0.5);
          add(bp[0], bp[1], bp[2], 'sub', h.key, '', hidx);
          link(si, nodes.length - 1, h.key);
        }
      });
      HUBS.push(Hobj);
    });

    function hubOf(i) {
      var n = nodes[i];
      if (n.kind === 'core') return -1;
      return n.hubId;
    }
    function pathToCore(i) {
      var path = [i];
      var g = 0;
      while (nodes[i].parent >= 0 && g++ < 20) {
        i = nodes[i].parent;
        path.push(i);
      }
      return path;
    } // ends at core

    function resize() {
      W = window.innerWidth;
      H = window.innerHeight;
      cx = W / 2;
      cy = H / 2;
      canvas.width = Math.max(1, W * DPR);
      canvas.height = Math.max(1, H * DPR);
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      links.setAttribute('width', W);
      links.setAttribute('height', H);
      links.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
    }
    window.addEventListener('resize', resize);
    resize();

    var yaw = 0.5,
      pitch = -0.16,
      dist = 10.5,
      distT = 10.5,
      focus = { x: 0, y: 0, z: 0 },
      focusT = { x: 0, y: 0, z: 0 };
    var renderCX, cxT;
    renderCX = cx;
    cxT = cx;
    var clusterFade = 0,
      clusterFadeT = 0; // 0 = full graph, 1 = only detail cluster
    var dragging = false,
      lx = 0,
      ly = 0,
      moved = 0,
      mX = null,
      mY = null,
      hoverI = -1,
      mode = 'intro',
      detailHub = -1,
      pathAnim = 0;

    // detail panel width fraction of viewport when open (full-width on mobile)
    function detailCX() {
      return W <= 760 ? W * 0.5 : W * 0.3;
    }

    function project(n) {
      var x = n.x - focus.x,
        y = n.y - focus.y,
        z = n.z - focus.z;
      var x1 = x * Math.cos(yaw) - z * Math.sin(yaw),
        z1 = x * Math.sin(yaw) + z * Math.cos(yaw),
        y1 = y;
      var y2 = y1 * Math.cos(pitch) - z1 * Math.sin(pitch),
        z2 = y1 * Math.sin(pitch) + z1 * Math.cos(pitch),
        x2 = x1;
      var zc = dist - z2;
      if (zc < 0.35) return null;
      var f = (Math.min(W, H) * 1.02) / zc;
      return { sx: renderCX + x2 * f, sy: cy + y2 * f, d: zc, f: f };
    }
    function alpha(d) {
      return Math.max(0.05, Math.min(1, (dist + 4 - d) / 9));
    }
    var P = [];

    function frame() {
      focus.x += (focusT.x - focus.x) * 0.12;
      focus.y += (focusT.y - focus.y) * 0.12;
      focus.z += (focusT.z - focus.z) * 0.12;
      dist += (distT - dist) * 0.1;
      renderCX += (cxT - renderCX) * 0.12;
      clusterFade += (clusterFadeT - clusterFade) * 0.1;
      if (mode === 'graph' && !dragging && hoverI < 0 && !reduce) yaw += 0.0009;
      if (mode === 'detail' && !dragging && !reduce) yaw += 0.0011;
      pathAnim += 0.03;

      P = nodes.map(project);
      ctx.clearRect(0, 0, W, H);

      // hover path is DESKTOP-only (touch uses tap -> dissect)
      var hl = hoverI >= 0 && mode === 'graph' && !isTouch;
      var path = hl ? pathToCore(hoverI) : null;
      var pathSet = {},
        pathEdge = {};
      if (hl) {
        for (var k = 0; k < path.length; k++) {
          pathSet[path[k]] = 1;
          if (k < path.length - 1) {
            var a = path[k],
              b = path[k + 1];
            pathEdge[a + '_' + b] = 1;
            pathEdge[b + '_' + a] = 1;
          }
        }
      }

      // edges
      for (var e = 0; e < edges.length; e++) {
        var E = edges[e],
          A = P[E.a],
          B = P[E.b];
        if (!A || !B) continue;
        var inCluster =
          detailHub < 0 ||
          nodes[E.a].hubId === detailHub ||
          nodes[E.b].hubId === detailHub ||
          E.a === core ||
          E.b === core;
        var cfade = clusterFade > 0.02 ? (inCluster ? 1 : 1 - clusterFade) : 1;
        if (cfade <= 0.02) continue;
        var onPath = hl && pathEdge[E.a + '_' + E.b];
        if (hl) {
          if (onPath) {
            ctx.strokeStyle = 'rgba(' + (COL[E.g] || COL.core) + ',0.9)';
            ctx.lineWidth = 1.7;
          } else {
            ctx.strokeStyle = 'rgba(27,27,30,0.04)';
            ctx.lineWidth = 0.7;
          }
        } else {
          var al = Math.min(alpha(A.d), alpha(B.d)) * 0.24 * cfade;
          if (al <= 0.015) continue;
          ctx.strokeStyle = 'rgba(27,27,30,' + al.toFixed(3) + ')';
          ctx.lineWidth = 0.8;
        }
        ctx.beginPath();
        ctx.moveTo(A.sx, A.sy);
        ctx.lineTo(B.sx, B.sy);
        ctx.stroke();
      }
      // animated token along hovered path (algorithm walking to core)
      if (hl && path.length > 1) {
        var seg = pathAnim % (path.length - 1);
        var si2 = Math.floor(seg),
          t = seg - si2;
        var A2 = P[path[si2]],
          B2 = P[path[si2 + 1]];
        if (A2 && B2) {
          var px = A2.sx + (B2.sx - A2.sx) * t,
            py = A2.sy + (B2.sy - A2.sy) * t;
          ctx.fillStyle = 'rgba(' + (COL[nodes[hoverI].group] || COL.core) + ',1)';
          ctx.beginPath();
          ctx.arc(px, py, 3.4, 0, 6.2832);
          ctx.fill();
        }
      }
      // nodes (painter's-order back-to-front)
      var order = [];
      for (var i = 0; i < nodes.length; i++) if (P[i]) order.push(i);
      order.sort(function (a, b) {
        return P[b].d - P[a].d;
      });
      for (var o = 0; o < order.length; o++) {
        var idx = order[o],
          n = nodes[idx],
          p = P[idx];
        var inClusterN = detailHub < 0 || n.hubId === detailHub || idx === core;
        var cfadeN = clusterFade > 0.02 ? (inClusterN ? 1 : 1 - clusterFade) : 1;
        if (cfadeN <= 0.02) continue;
        var c = COL[n.group] || COL.core;
        var a0 = alpha(p.d);
        var vis = hl ? (pathSet[idx] ? 1 : 0.12) : 1;
        var al2 = a0 * vis * cfadeN;
        var isHover = idx === hoverI && !isTouch;
        var base =
          n.kind === 'core' ? 10 : n.kind === 'hub' ? 6.5 : n.kind === 'sat' ? 2.9 : 1.9;
        var r =
          Math.max(1.4, base * (p.f / (Math.min(W, H) * 0.12))) * (isHover ? 1.4 : 1);
        if (n.kind === 'core') {
          ctx.fillStyle = 'rgba(27,27,30,' + Math.min(1, al2) + ')';
          ctx.beginPath();
          ctx.arc(p.sx, p.sy, r, 0, 6.2832);
          ctx.fill();
          ctx.strokeStyle = 'rgba(27,27,30,' + al2 * 0.35 + ')';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(p.sx, p.sy, r + 8, 0, 6.2832);
          ctx.stroke();
        } else {
          ctx.fillStyle = 'rgba(' + c + ',' + Math.min(1, al2).toFixed(3) + ')';
          ctx.beginPath();
          ctx.arc(p.sx, p.sy, r, 0, 6.2832);
          ctx.fill();
          if (n.kind === 'hub') {
            ctx.strokeStyle = 'rgba(' + c + ',' + al2 * 0.4 + ')';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.arc(p.sx, p.sy, r + 5, 0, 6.2832);
            ctx.stroke();
          }
        }
        var showLabel =
          n.kind === 'core' ||
          (n.kind === 'hub' && (!hl || pathSet[idx])) ||
          isHover ||
          (mode === 'detail' && n.hubId === detailHub && n.kind === 'sat');
        if (showLabel && n.label) {
          var big = n.kind === 'core';
          ctx.font =
            (big ? '600 ' : n.kind === 'hub' ? '600 ' : '400 ') +
            (big ? 15 : n.kind === 'hub' ? 13 : 11) +
            'px ' +
            (n.kind === 'sub' || n.kind === 'sat'
              ? 'ui-monospace,monospace'
              : '-apple-system,system-ui,sans-serif');
          ctx.fillStyle = 'rgba(27,27,30,' + Math.min(1, al2 + 0.25) + ')';
          ctx.textAlign = 'center';
          ctx.fillText(n.label, p.sx, p.sy - r - (big ? 12 : 9));
        }
      }
      // connector lines from aspect cards to their nodes (detail mode)
      if (mode === 'detail' && detailHub >= 0) {
        var svg = '';
        var H2 = HUBS[detailHub];
        H2.aspects.forEach(function (asp, ai) {
          var el = document.getElementById('mtc-acard-' + ai);
          var np = P[asp.node];
          if (!el || !np) return;
          var rc = el.getBoundingClientRect();
          var cxp = rc.left,
            cyp = rc.top + rc.height / 2;
          var col = HEX[H2.g];
          svg +=
            '<path d="M ' +
            np.sx +
            ' ' +
            np.sy +
            ' C ' +
            (np.sx + cxp) / 2 +
            ' ' +
            np.sy +
            ', ' +
            (np.sx + cxp) / 2 +
            ' ' +
            cyp +
            ', ' +
            cxp +
            ' ' +
            cyp +
            '" fill="none" stroke="' +
            col +
            '" stroke-width="1" opacity="0.5"/>';
          svg += '<circle cx="' + np.sx + '" cy="' + np.sy + '" r="3.2" fill="' + col + '"/>';
        });
        links.innerHTML = svg;
      } else if (links.innerHTML) links.innerHTML = '';

      // hover pick (desktop only)
      if (mX != null && !dragging && mode === 'graph' && !isTouch) {
        var best = -1,
          bd = 1e9;
        for (var j = 0; j < nodes.length; j++) {
          if (!P[j]) continue;
          var dx = P[j].sx - mX,
            dy = P[j].sy - mY,
            dd = dx * dx + dy * dy;
          if (dd < bd) {
            bd = dd;
            best = j;
          }
        }
        hoverI = bd < 28 * 28 ? best : -1;
        canvas.classList.toggle('point', hoverI >= 0);
      }
      raf = requestAnimationFrame(frame);
    }
    var raf = requestAnimationFrame(frame);

    // -----------------------------------------------------------------------
    // Pointer interaction (orbit / zoom / click-or-tap to dissect)
    // -----------------------------------------------------------------------
    canvas.addEventListener('pointerdown', function (e) {
      if (mode !== 'graph' && mode !== 'detail') return;
      dragging = true;
      moved = 0;
      canvas.classList.add('grab');
      lx = e.clientX;
      ly = e.clientY;
      canvas.setPointerCapture && canvas.setPointerCapture(e.pointerId);
    });
    window.addEventListener('pointermove', function (e) {
      mX = e.clientX;
      mY = e.clientY;
      if (dragging) {
        var dx = e.clientX - lx,
          dy = e.clientY - ly;
        moved += Math.abs(dx) + Math.abs(dy);
        yaw += dx * 0.006;
        pitch = Math.max(-1.2, Math.min(1.2, pitch + dy * 0.006));
        lx = e.clientX;
        ly = e.clientY;
      }
    });
    window.addEventListener('pointerup', function (e) {
      if (dragging && moved < 6 && mode === 'graph') {
        // resolve which node was tapped/clicked (on touch we have no live hover)
        var target = hoverI;
        if (isTouch || target < 0) {
          var best = -1,
            bd = 1e9,
            px = e.clientX,
            py = e.clientY;
          for (var j = 0; j < nodes.length; j++) {
            if (!P[j]) continue;
            var dx = P[j].sx - px,
              dy = P[j].sy - py,
              dd = dx * dx + dy * dy;
            if (dd < bd) {
              bd = dd;
              best = j;
            }
          }
          // slightly larger tap radius on touch
          if (bd < (isTouch ? 34 * 34 : 28 * 28)) target = best;
        }
        if (target >= 0) {
          var h = hubOf(target);
          if (h >= 0) openDetail(h);
        }
      }
      dragging = false;
      canvas.classList.remove('grab');
    });
    canvas.addEventListener(
      'wheel',
      function (e) {
        if (mode !== 'graph') return;
        e.preventDefault();
        distT = Math.max(5, Math.min(17, distT * (1 + e.deltaY * 0.0011)));
      },
      { passive: false }
    );

    // -----------------------------------------------------------------------
    // Dissect (dive) + return
    // -----------------------------------------------------------------------
    var detail = document.getElementById('mtc-detail'),
      backBtn = document.getElementById('mtc-back');

    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function openDetail(h) {
      var H2 = HUBS[h];
      detailHub = h;
      mode = 'diving';
      hoverI = -1;
      var hn = nodes[H2.idx];
      focusT = { x: hn.x, y: hn.y, z: hn.z };
      distT = 4.6;
      cxT = detailCX();
      clusterFadeT = 1;
      var col = HEX[H2.g];
      var idxLabel = String(h + 1).padStart(2, '0');
      detail.style.setProperty('--acc', col);
      detail.innerHTML =
        '<div class="dhead"><span class="k" style="color:' +
        col +
        '">' +
        idxLabel +
        '</span><h2>' +
        esc(H2.label) +
        '</h2></div>' +
        '<p class="dkick">' + esc(UI.dissected || 'nó dissecado') + '</p>' +
        '<div class="dmark"><span></span><span></span></div>' +
        H2.aspects
          .map(function (asp, ai) {
            return (
              '<div class="acard" id="mtc-acard-' +
              ai +
              '"><p class="num"><i style="background:' +
              col +
              '"></i><b>' +
              String(ai + 1).padStart(2, '0') +
              '</b> · ' +
              esc(asp.label) +
              '</p><h3>' +
              esc(asp.title) +
              '</h3><ul>' +
              asp.items
                .map(function (it) {
                  return '<li>' + esc(it) + '</li>';
                })
                .join('') +
              '</ul></div>'
            );
          })
          .join('') +
        (H2.route
          ? '<a class="dlink" style="color:' +
            col +
            '" href="' +
            esc(H2.route) +
            '">' +
            (UI.viewPage ? esc(UI.viewPage).replace('{label}', esc(H2.label)) : 'ver página ' + esc(H2.label)) +
            ' →</a>'
          : '');
      // reduced-motion: reveal everything immediately, no cascade
      if (reduce) {
        mode = 'detail';
        detail.classList.add('open');
        backBtn.classList.add('show');
        H2.aspects.forEach(function (a, ai) {
          var el = document.getElementById('mtc-acard-' + ai);
          if (el) el.classList.add('in');
        });
        return;
      }
      setTimeout(function () {
        mode = 'detail';
        detail.classList.add('open');
        backBtn.classList.add('show');
        H2.aspects.forEach(function (a, ai) {
          setTimeout(function () {
            var el = document.getElementById('mtc-acard-' + ai);
            if (el) el.classList.add('in');
          }, 120 + ai * 130);
        });
      }, 520);
    }
    function closeDetail() {
      mode = 'undiving';
      detail.classList.remove('open');
      backBtn.classList.remove('show');
      links.innerHTML = '';
      focusT = { x: 0, y: 0, z: 0 };
      distT = 10.5;
      cxT = W / 2;
      clusterFadeT = 0;
      setTimeout(
        function () {
          if (mode === 'undiving') {
            mode = 'graph';
            detailHub = -1;
          }
        },
        reduce ? 0 : 560
      );
    }
    backBtn.addEventListener('click', closeDetail);
    var logo = root.querySelector('[data-mtc-logo]');
    if (logo)
      logo.addEventListener('click', function (e) {
        // when the graph is live, the logo returns to the system rather than navigating
        if (mode === 'detail' || mode === 'diving') {
          e.preventDefault();
          closeDetail();
        }
      });
    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && mode === 'detail') closeDetail();
    });
    window.addEventListener('resize', function () {
      cxT = mode === 'detail' ? detailCX() : W / 2;
    });

    // -----------------------------------------------------------------------
    // Intro (2s MATECNO fade). Reduced-motion collapses the wait to instant.
    // -----------------------------------------------------------------------
    var intro = document.getElementById('mtc-intro'),
      nav = document.getElementById('mtc-nav'),
      hint = document.getElementById('mtc-hint');
    function revealSystem() {
      if (intro) intro.classList.add('hide');
      if (nav) nav.classList.add('show');
      if (hint) hint.classList.add('show');
      mode = 'graph';
    }
    if (reduce) {
      revealSystem();
    } else {
      setTimeout(revealSystem, 2000);
    }
  })();
</script>
