---
import Layout from '../layouts/Layout.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getSite, alternatesFor } from '../data/site.mjs';

interface Props { hubKey: string; lang: string }
const { hubKey, lang } = Astro.props;

const site = getSite(lang);
const hub = site.hubs.find((h) => h.key === hubKey);
const { title, description, h1, paras, cta } = hub.page;
const color = hub.color;
const lead = paras[0];
const body = paras.slice(1);
const others = site.hubs.filter((h) => h.key !== hubKey);
const ui = site.ui;
const alternates = alternatesFor(hubKey);

const WA_HREF = `https://wa.me/351919642845?text=${encodeURIComponent(ui.waMessage)}`;
const MAIL_HREF = 'mailto:geral@matecno.pt';
const mono = 'font-mono';
---

<Layout
  title={title}
  description={description}
  lang={lang}
  htmlLang={site.htmlLang}
  ogLocale={site.ogLocale}
  jsonld={site.seo.jsonld}
  alternates={alternates}
  ui={ui}
>
  <div class="min-h-screen bg-white text-gray-900 antialiased">
    <!-- node-colour top accent -->
    <div class="h-[3px] w-full" style={`background:${color}`}></div>

    <!-- nav -->
    <header class="border-b border-gray-100">
      <nav class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-6 gap-y-2 px-6 py-4 text-[13px]">
        <a href={site.core.route} class={`${mono} font-semibold tracking-[0.14em] text-gray-900`}>MATECNO</a>
        <span class="text-gray-300">/</span>
        {site.hubs.map((h) => (
          <a
            href={h.route}
            class:list={[
              'transition-colors hover:text-gray-900',
              h.key === hubKey ? 'text-gray-900 font-medium' : 'text-gray-400',
            ]}
          >{h.label}</a>
        ))}
        <LangSwitcher alternates={alternates} current={lang} class="ml-auto" />
      </nav>
    </header>

    <main class="mx-auto max-w-4xl px-6 pb-24 pt-14 sm:pt-20">
      <!-- hero -->
      <p class={`${mono} flex items-center gap-2.5 text-[11px] uppercase tracking-[0.2em] text-gray-400`}>
        <span class="inline-block h-2 w-2 rounded-full" style={`background:${color}`}></span>
        {hub.label} — {ui.sectionEyebrow}
      </p>
      <div class="mb-8 mt-5 flex flex-col gap-[5px]">
        <span class="block h-px w-9" style={`background:${color}`}></span>
        <span class="block h-px w-5" style={`background:${color}`}></span>
      </div>

      <h1 class="max-w-[20ch] text-[2.4rem] font-semibold leading-[1.05] tracking-tight text-gray-900 sm:text-[3.2rem]">{h1}</h1>
      <p class="mt-7 max-w-[44ch] text-xl font-light leading-relaxed text-gray-500 sm:text-[1.6rem]">{lead}</p>

      {body.length > 0 && (
        <div class="mt-10 max-w-[62ch] space-y-5 text-[1.05rem] leading-relaxed text-gray-600">
          {body.map((p) => <p>{p}</p>)}
        </div>
      )}

      <!-- aspect cards -->
      <div class="mb-6 mt-16 flex items-center gap-3">
        <span class={`${mono} text-[11px] uppercase tracking-[0.16em] text-gray-400`}>{ui.detalhe}</span>
        <span class="h-px flex-1 bg-gray-100"></span>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {hub.aspects.map((asp, i) => (
          <div class="group rounded-2xl border border-gray-200/80 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-[0_18px_40px_-28px_rgba(0,0,0,0.35)]">
            <div class="mb-4 flex items-center gap-2">
              <span class={`${mono} text-[11px] font-medium tracking-[0.1em]`} style={`color:${color}`}>{String(i + 1).padStart(2, '0')}</span>
              <span class="h-px flex-1 bg-gray-100"></span>
            </div>
            <h3 class="mb-3 text-[15px] font-semibold leading-snug text-gray-900">{asp.title}</h3>
            <ul class="space-y-2">
              {asp.items.map((it) => (
                <li class="flex gap-2.5 text-[13.5px] leading-snug text-gray-600">
                  <span class="mt-[7px] inline-block h-1 w-1 shrink-0 rounded-full" style={`background:${color}`}></span>
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="relative mt-16 overflow-hidden rounded-3xl p-8 text-white sm:p-11" style={`background:${color}`}>
        <p class={`${mono} mb-4 text-[11px] uppercase tracking-[0.2em] text-white/70`}>{ui.nextStep}</p>
        <p class="mb-8 max-w-[34ch] text-xl font-medium leading-snug sm:text-[1.7rem]">{cta}</p>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={WA_HREF} target="_blank" rel="noopener"
            class="inline-flex items-center justify-center gap-2.5 rounded-full bg-white px-7 py-3.5 text-[15px] font-semibold text-gray-900 transition-transform hover:-translate-y-0.5">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35Z"/></svg>
            WhatsApp — +351 919 642 845
          </a>
          <a href={MAIL_HREF}
            class="inline-flex items-center justify-center gap-2.5 rounded-full border border-white/70 px-7 py-3.5 text-[15px] font-semibold text-white transition-colors hover:bg-white/10">
            geral@matecno.pt
          </a>
        </div>
      </div>

      <!-- explore other nodes -->
      <div class="mt-16 border-t border-gray-100 pt-8">
        <p class={`${mono} mb-4 text-[11px] uppercase tracking-[0.16em] text-gray-400`}>{ui.otherNodes}</p>
        <div class="flex flex-wrap gap-2.5">
          {others.map((o) => (
            <a href={o.route}
              class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 text-[13.5px] text-gray-600 transition-colors hover:border-gray-300 hover:text-gray-900">
              <span class="inline-block h-1.5 w-1.5 rounded-full" style={`background:${o.color}`}></span>
              {o.label}
            </a>
          ))}
        </div>
        <a href={site.core.route} class={`${mono} mt-7 inline-block text-[12px] text-gray-400 transition-colors hover:text-gray-900`}>← {ui.backToGraph}</a>
      </div>
    </main>
  </div>
</Layout>
