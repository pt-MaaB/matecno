---
const services = [
  { href: '/servicos/redes', label: 'Redes e Wi-Fi' },
  { href: '/servicos/servidores', label: 'Servidores' },
  { href: '/servicos/ciberseguranca', label: 'Cibersegurança' },
  { href: '/servicos/emails-profissionais', label: 'Emails Profissionais' },
  { href: '/servicos/alojamento-web', label: 'Alojamento Web' },
  { href: '/servicos/design-websites', label: 'Design de Websites' },
  { href: '/servicos/seo', label: 'SEO' },
];

const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <p class="text-white font-bold text-lg mb-2">MaTecno</p>
        <p class="text-sm leading-relaxed">
          Serviços de tecnologia e informática para empresas em Coimbra. Soluções profissionais acessíveis para PMEs.
        </p>
        <a href="tel:+351919642845" class="mt-3 inline-block text-brand-light hover:underline text-sm">
          +351 919 642 845
        </a>
      </div>

      <!-- Services -->
      <div>
        <p class="text-white font-semibold mb-3">Serviços</p>
        <ul class="space-y-2">
          {services.map(s => (
            <li>
              <a href={s.href} class="text-sm hover:text-white transition-colors">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="text-white font-semibold mb-3">Contacto</p>
        <ul class="space-y-2 text-sm">
          <li>📍 Coimbra, Portugal</li>
          <li>
            <a href="tel:+351919642845" class="hover:text-white transition-colors">📞 +351 919 642 845</a>
          </li>
          <li>
            <a href="mailto:geral@matecno.pt" class="hover:text-white transition-colors">✉️ geral@matecno.pt</a>
          </li>
          <li>
            <a
              href="https://wa.me/351919642845"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >💬 WhatsApp</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-700 mt-8 pt-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-gray-500">
      <p>© {year} MaTecno — Todos os direitos reservados</p>
      <p>Feito com ❤️ em Coimbra, Portugal</p>
    </div>
  </div>
</footer>
