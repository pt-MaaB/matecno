---
import Layout from '../layouts/Layout.astro';
import { HUBS, CORE } from '../data/site.mjs';

const hub = HUBS.find((h) => h.key === 'produtos');
const { title, description, h1, paras, cta } = hub.page;
const color = hub.color;

const WA_HREF = 'https://wa.me/351919642845?text=Ol%C3%A1%2C%20gostaria%20de%20agendar%20um%20diagn%C3%B3stico';
const MAIL_HREF = 'mailto:geral@matecno.pt';
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-white text-gray-900">
    <!-- Top nav -->
    <header class="border-b border-gray-100">
      <nav class="max-w-3xl mx-auto flex flex-wrap items-center gap-x-5 gap-y-2 px-5 py-4 text-sm">
        <a href="/" class="font-semibold tracking-wide text-gray-900">MATECNO</a>
        <span class="text-gray-300">/</span>
        {HUBS.map((h) => (
          <a
            href={h.route}
            class:list={[
              'text-gray-500 hover:text-gray-900 transition-colors',
              h.key === hub.key && 'text-gray-900 font-medium',
            ]}
          >{h.label}</a>
        ))}
      </nav>
    </header>

    <main class="max-w-3xl mx-auto px-5 py-12 sm:py-16">
      <span class="inline-block h-1.5 w-10 rounded-full mb-6" style={`background:${color}`}></span>
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight leading-tight mb-8">{h1}</h1>

      <div class="space-y-5 text-gray-700 leading-relaxed text-[1.05rem]">
        {paras.map((p) => <p>{p}</p>)}
      </div>

      <!-- Aspect cards -->
      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {hub.aspects.map((asp) => (
          <div class="rounded-2xl border border-gray-100 shadow-sm p-6">
            <h2 class="font-semibold text-lg mb-4 flex items-center gap-2.5">
              <span class="inline-block w-2 h-2 rounded-full" style={`background:${color}`}></span>
              {asp.title}
            </h2>
            <ul class="space-y-2 text-gray-700 text-[0.95rem]">
              {asp.items.map((it) => (
                <li class="flex gap-2.5">
                  <span class="mt-2 inline-block w-1 h-1 rounded-full bg-gray-300 shrink-0"></span>
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Lead-capture CTA -->
      <div class="mt-14 rounded-2xl p-7 sm:p-9 text-white shadow-lg" style={`background:${color}`}>
        <p class="text-lg sm:text-xl font-semibold leading-snug mb-6">{cta}</p>
        <div class="flex flex-col sm:flex-row flex-wrap gap-3">
          <a href={WA_HREF} target="_blank" rel="noopener"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-6 py-3.5 font-semibold text-gray-900 shadow-sm hover:bg-gray-100 transition-colors">
            <span aria-hidden="true">💬</span> WhatsApp — +351 919 642 845
          </a>
          <a href={MAIL_HREF}
            class="inline-flex items-center justify-center gap-2 rounded-xl border-2 border-white/80 px-6 py-3.5 font-semibold text-white hover:bg-white/10 transition-colors">
            <span aria-hidden="true">✉️</span> geral@matecno.pt
          </a>
        </div>
      </div>

      <p class="mt-10 text-sm">
        <a href={CORE.route} class="text-gray-500 hover:text-gray-900 transition-colors">← Voltar ao início</a>
      </p>
    </main>
  </div>
</Layout>
