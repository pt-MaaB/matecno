---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABanner from '../../components/CTABanner.astro';

const services = [
  { title: 'Redes e Wi-Fi Empresarial', description: 'Configuração e manutenção de redes, switches, routers e Wi-Fi para escritórios e lojas em Coimbra.', href: '/servicos/redes', icon: '🌐' },
  { title: 'Administração de Servidores', description: 'Gestão e manutenção de servidores Windows Server e Linux para PMEs.', href: '/servicos/servidores', icon: '🖥️' },
  { title: 'Cibersegurança para PMEs', description: 'Proteja os dados e sistemas da sua empresa com soluções de segurança informática acessíveis.', href: '/servicos/ciberseguranca', icon: '🔒' },
  { title: 'Emails Profissionais', description: 'Configuração de Microsoft 365 e Google Workspace com o domínio da sua empresa.', href: '/servicos/emails-profissionais', icon: '📧' },
  { title: 'Alojamento Web', description: 'Hosting rápido, seguro e fiável para websites empresariais em Portugal.', href: '/servicos/alojamento-web', icon: '☁️' },
  { title: 'Design de Websites', description: 'Criação de websites profissionais para empresas em Coimbra que geram leads e clientes.', href: '/servicos/design-websites', icon: '🎨' },
  { title: 'SEO — Posicionamento no Google', description: 'Estratégias de SEO para empresas em Coimbra aparecerem no topo das pesquisas Google.', href: '/servicos/seo', icon: '📈' },
];
---

<Layout
  title="Serviços IT para Empresas em Coimbra | MaTecno"
  description="MaTecno oferece serviços completos de IT para empresas em Coimbra: redes, servidores, cibersegurança, emails profissionais, alojamento web, design de websites e SEO."
>
  <Header />

  <section class="bg-brand-dark py-14 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold text-white mb-4">Serviços IT para Empresas em Coimbra</h1>
      <p class="text-blue-200 text-lg">Soluções de tecnologia completas para pequenas e médias empresas. Desde redes e servidores até websites e SEO.</p>
    </div>
  </section>

  <section class="py-16 px-4 bg-gray-50">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(s => <ServiceCard {...s} />)}
      </div>
    </div>
  </section>

  <CTABanner />
  <Footer />
</Layout>
