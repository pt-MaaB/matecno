---
// /blog/ — the MaTecno blog index, newest post first (title, kicker, a one-line teaser from the direct answer, date).
// A rest route on purpose, not index.astro: a static index.astro is always emitted, and with ZERO posts there must
// be no /blog/ page at all (no thin empty page). getStaticPaths returns no path then, so nothing is built, and the
// sitemap (built from the emitted pages) has no /blog/ either. Wording: src/data/blog_index.json.
import Layout from '../../layouts/Layout.astro';
import BlogHeader from '../../components/BlogHeader.astro';
import { getSite } from '../../data/site.mjs';
import { COLORS } from '../../data/structure.mjs';
import { BLOG, BLOG_ROUTE, blogPosts, colorFor, dateLabel, displayTitle, indexJsonLd, plain, teaser } from '../../lib/blog';

export function getStaticPaths() {
  return blogPosts().length ? [{ params: { index: undefined } }] : [];
}

const site = getSite('pt');
const posts = blogPosts();
const alternates = [{ lang: 'pt', htmlLang: site.htmlLang, href: BLOG_ROUTE }];
const mono = 'font-mono';
---

<Layout
  title={plain(BLOG.title)}
  description={plain(BLOG.description)}
  lang="pt"
  htmlLang={site.htmlLang}
  ogLocale={site.ogLocale}
  jsonld={indexJsonLd()}
  alternates={alternates}
  ui={site.ui}
>
  <div class="min-h-screen bg-white text-gray-900 antialiased">
    <BlogHeader color={COLORS.core} />

    <main class="mx-auto max-w-4xl px-6 pb-24 pt-14 sm:pt-20">
      <p class={`${mono} flex items-center gap-2.5 text-[11px] uppercase tracking-[0.2em] text-gray-400`}>
        <span class="inline-block h-2 w-2 rounded-full" style={`background:${COLORS.core}`}></span>
        {BLOG.navLabel}
      </p>
      <div class="mb-8 mt-5 flex flex-col gap-[5px]">
        <span class="block h-px w-9" style={`background:${COLORS.core}`}></span>
        <span class="block h-px w-5" style={`background:${COLORS.core}`}></span>
      </div>
      <h1 class="max-w-[20ch] text-[2.4rem] font-semibold leading-[1.05] tracking-tight text-gray-900 sm:text-[3.2rem]">{BLOG.h1}</h1>
      <p class="mt-7 max-w-[52ch] text-xl font-light leading-relaxed text-gray-500 sm:text-[1.4rem]">{BLOG.intro}</p>

      <ol class="mt-14 space-y-4">
        {posts.map((p) => (
          <li>
            <a href={p.slug}
              class="group block rounded-2xl border border-gray-200/80 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-[0_18px_40px_-28px_rgba(0,0,0,0.35)] sm:p-7">
              <p class={`${mono} flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[11px] uppercase tracking-[0.16em] text-gray-400`}>
                <span class="inline-block h-1.5 w-1.5 rounded-full" style={`background:${colorFor(p)}`}></span>
                <span>{p.kicker}</span>
                <span aria-hidden="true">·</span>
                <time datetime={p.published} class="normal-case tracking-[0.08em]">{dateLabel(p.published)}</time>
              </p>
              <h2 class="mt-3 text-[1.3rem] font-semibold leading-snug tracking-tight text-gray-900 group-hover:underline group-hover:decoration-gray-300 group-hover:underline-offset-4">{displayTitle(p)}</h2>
              <p class="mt-2 text-[15px] leading-relaxed text-gray-500">{teaser(p)}</p>
            </a>
          </li>
        ))}
      </ol>
    </main>
  </div>
</Layout>
