---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.image,
  "datePublished": post.data.pubDate,
  "author": {
    "@type": "Organization",
    "name": "MaTecno",
    "url": "https://matecno.pt"
  },
  "publisher": {
    "@type": "Organization",
    "name": "MaTecno",
    "url": "https://matecno.pt"
  }
};
---

<Layout
  title={`${post.data.title} | MaTecno Blog`}
  description={post.data.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  <Header />

  <article>
    <!-- Post Header -->
    <header class="bg-brand-dark py-14 px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <nav class="text-sm text-blue-300 mb-4">
          <a href="/" class="hover:text-white transition-colors">Início</a>
          {' / '}
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          {' / '}
          <span class="text-blue-200">{post.data.category}</span>
        </nav>
        <div class="flex items-center justify-center gap-3 mb-4">
          <span class="text-sm bg-blue-700 text-white px-3 py-1 rounded-full">
            {post.data.categoryIcon} {post.data.category}
          </span>
          <span class="text-blue-300 text-sm">{post.data.readTime}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white leading-snug">
          {post.data.title}
        </h1>
      </div>
    </header>

    <!-- Featured Image -->
    <div class="max-w-4xl mx-auto px-4 -mt-6 relative z-10">
      <img
        src={post.data.image}
        alt={post.data.imageAlt}
        class="w-full h-64 md:h-80 object-cover rounded-xl shadow-lg"
        loading="eager"
      />
    </div>

    <!-- Post Content -->
    <div class="max-w-4xl mx-auto px-4 py-12">
      <div class="prose prose-lg prose-headings:text-gray-900 prose-a:text-brand prose-a:no-underline hover:prose-a:underline prose-blockquote:border-brand prose-blockquote:bg-blue-50 prose-blockquote:not-italic prose-blockquote:rounded-r-lg prose-blockquote:py-1 prose-strong:text-gray-900 max-w-none">
        <Content />
      </div>
    </div>
  </article>

  <!-- Back to Blog -->
  <div class="max-w-4xl mx-auto px-4 pb-12">
    <a href="/blog" class="inline-flex items-center gap-2 text-brand font-semibold hover:underline">
      ← Voltar ao Blog
    </a>
  </div>

  <!-- CTA Section -->
  <section class="bg-brand-dark py-14 px-4 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold text-white mb-3">Precisa de Ajuda para a Sua Empresa?</h2>
      <p class="text-blue-200 mb-6">A MaTecno oferece suporte informático profissional para PMEs em Coimbra.</p>
      <a
        href="/contacto"
        class="inline-block px-6 py-3 bg-white text-brand-dark font-bold rounded-lg hover:bg-blue-50 transition-colors"
      >
        Solicitar Avaliação Gratuita
      </a>
    </div>
  </section>

  <Footer />
</Layout>
