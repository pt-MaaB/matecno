---
// One MaTecno blog post per file in src/data/blog/<slug>.json (contract and checks: src/lib/blog.ts; spec: ANTI
// Deliverables/marketing/matecno/seo/page_kind_blog.md). PT only (spec 3): a post has no en/es twin until one is
// approved, so it carries no other hreflang. Everything is in the static HTML: the short answer first, every
// section, every FAQ answer. The complaint and the claims are review evidence and are never rendered.
import Layout from '../../layouts/Layout.astro';
import BlogHeader from '../../components/BlogHeader.astro';
import Inline from '../../components/Inline.astro';
import { getSite } from '../../data/site.mjs';
import { AUTHOR, BLOG, BLOG_ROUTE, blogPosts, colorFor, dateLabel, pageRef, plain, postJsonLd, type BlogPost } from '../../lib/blog';

export function getStaticPaths() {
  return blogPosts().map((post) => ({ params: { slug: post.slug.slice('/blog/'.length, -1) }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const site = getSite('pt');
const L = BLOG.labels;
const color = colorFor(post);
const related = post.related.map(pageRef);
const alternates = [{ lang: 'pt', htmlLang: site.htmlLang, href: post.slug }];
const mono = 'font-mono';
const bodyText = 'text-[1.05rem] leading-relaxed text-gray-600';
---

<Layout
  title={plain(post.title)}
  description={plain(post.description)}
  lang="pt"
  htmlLang={site.htmlLang}
  ogLocale={site.ogLocale}
  jsonld={postJsonLd(post)}
  alternates={alternates}
  ui={site.ui}
  ogType="article"
>
  <div class="min-h-screen bg-white text-gray-900 antialiased">
    <BlogHeader color={color} />

    <main class="mx-auto max-w-4xl px-6 pb-24 pt-10 sm:pt-14">
      <article>
        <nav aria-label={L.breadcrumb} class={`${mono} text-[11px] tracking-[0.08em] text-gray-400`}>
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href="/" class="transition-colors hover:text-gray-900">{L.home}</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={BLOG_ROUTE} class="transition-colors hover:text-gray-900">{BLOG.navLabel}</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-gray-600">{post.navLabel}</li>
          </ol>
        </nav>

        <!-- hero -->
        <p class={`${mono} mt-10 flex items-center gap-2.5 text-[11px] uppercase tracking-[0.2em] text-gray-400`}>
          <span class="inline-block h-2 w-2 rounded-full" style={`background:${color}`}></span>
          {post.kicker}
        </p>
        <div class="mb-8 mt-5 flex flex-col gap-[5px]">
          <span class="block h-px w-9" style={`background:${color}`}></span>
          <span class="block h-px w-5" style={`background:${color}`}></span>
        </div>
        <h1 class="max-w-[24ch] text-[2.2rem] font-semibold leading-[1.08] tracking-tight text-gray-900 sm:text-[3rem]">{post.h1}</h1>
        <p class={`${mono} mt-6 text-[12px] text-gray-400`}>
          <span class="text-gray-500">{(L.by ?? 'Por') + ' ' + AUTHOR.name + ', ' + AUTHOR.role}</span>{' · '}
          {L.published + ' '}<time datetime={post.published}>{dateLabel(post.published)}</time>{post.updated !== post.published && (
            <span>{' · ' + L.updated + ' '}<time datetime={post.updated}>{dateLabel(post.updated)}</time></span>
          )}
        </p>

        <!-- the direct answer, first -->
        <div class="mt-10 max-w-[68ch] rounded-2xl border border-gray-200/80 bg-gray-50/70 p-6 sm:p-7" style={`border-left:3px solid ${color}`}>
          <p class={`${mono} text-[11px] uppercase tracking-[0.16em] text-gray-400`}>{L.answer}</p>
          <p class="mt-3 text-lg leading-relaxed text-gray-800 sm:text-[1.25rem]"><Inline text={post.answer} /></p>
        </div>

        {post.sections.length > 2 && (
          <nav aria-label={L.toc} class="mt-10 max-w-[68ch]">
            <p class={`${mono} mb-3 text-[11px] uppercase tracking-[0.16em] text-gray-400`}>{L.toc}</p>
            <ol class="list-decimal space-y-1.5 pl-5 text-[15px] text-gray-600 marker:text-gray-300">
              {post.sections.map((s) => (
                <li><a href={`#${s.id}`} class="transition-colors hover:text-gray-900">{s.h2}</a></li>
              ))}
            </ol>
          </nav>
        )}

        {post.sections.map((s) => (
          <section id={s.id} class="mt-14 max-w-[68ch] scroll-mt-6 space-y-5">
            <h2 class="text-[1.6rem] font-semibold leading-tight tracking-tight text-gray-900 sm:text-[1.9rem]">{s.h2}</h2>
            {s.blocks.map((b) => {
              if (b.type === 'p') return <p class={bodyText}><Inline text={b.text} /></p>;
              if (b.type === 'list') {
                const items = b.items.map((it) => <li><Inline text={it} /></li>);
                return b.ordered
                  ? <ol class={`list-decimal space-y-2 pl-5 marker:text-gray-400 ${bodyText}`}>{items}</ol>
                  : <ul class={`list-disc space-y-2 pl-5 marker:text-gray-400 ${bodyText}`}>{items}</ul>;
              }
              if (b.type === 'table') return (
                <div class="overflow-x-auto rounded-2xl border border-gray-200/80">
                  <table class="w-full caption-bottom text-left text-[14px]">
                    {b.caption && <caption class="px-4 py-3 text-left text-[13px] text-gray-400">{b.caption}</caption>}
                    <thead class="bg-gray-50 text-gray-900">
                      <tr>{b.head.map((h) => <th scope="col" class="whitespace-nowrap px-4 py-3 font-semibold">{h}</th>)}</tr>
                    </thead>
                    <tbody class="text-gray-600">
                      {b.rows.map((row) => (
                        <tr class="border-t border-gray-100">
                          {row.map((cell, i) => (
                            <td class:list={['px-4 py-3 align-top', i === 0 && 'font-medium text-gray-900']}><Inline text={cell} /></td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
              return (
                <div class="rounded-2xl border border-gray-200/80 bg-gray-50/70 p-5" style={`border-left:3px solid ${color}`}>
                  {b.title && <p class="mb-1 text-[15px] font-semibold text-gray-900">{b.title}</p>}
                  <p class="text-[15px] leading-relaxed text-gray-600"><Inline text={b.text} /></p>
                </div>
              );
            })}
          </section>
        ))}

        {post.faq.length > 0 && (
          <section id="perguntas" class="mt-16 max-w-[68ch] scroll-mt-6">
            <h2 class="text-[1.6rem] font-semibold leading-tight tracking-tight text-gray-900 sm:text-[1.9rem]">{L.faq}</h2>
            <div class="mt-6 divide-y divide-gray-100 border-y border-gray-100">
              {post.faq.map((f) => (
                <div class="py-5">
                  <h3 class="text-[1.05rem] font-semibold leading-snug text-gray-900">{f.q}</h3>
                  <p class="mt-2 text-[15px] leading-relaxed text-gray-600"><Inline text={f.a} /></p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- the next step: the service page (spec 6), or the honest "not our service" when there is none -->
        {post.service_link && post.cta ? (
          <div class="relative mt-16 overflow-hidden rounded-3xl p-8 text-white sm:p-11" style={`background:${color}`}>
            <p class={`${mono} mb-6 text-[11px] uppercase tracking-[0.2em] text-white/70`}>{L.nextStep}</p>
            <a href={post.service_link}
              class="inline-flex items-center justify-center gap-2.5 rounded-full bg-white px-7 py-3.5 text-[15px] font-semibold text-gray-900 transition-transform hover:-translate-y-0.5">
              {post.cta.label}<span aria-hidden="true">→</span>
            </a>
          </div>
        ) : (
          <div class="mt-16 rounded-3xl border border-gray-200 bg-gray-50 p-8 sm:p-11">
            <p class={`${mono} mb-4 text-[11px] uppercase tracking-[0.2em] text-gray-400`}>{L.notOurService}</p>
            <p class="max-w-[56ch] text-lg leading-relaxed text-gray-700"><Inline text={post.not_our_service_reason ?? ''} /></p>
          </div>
        )}

        <!-- related pages -->
        <nav aria-label={L.related} class="mt-16 border-t border-gray-100 pt-8">
          <p class={`${mono} mb-4 text-[11px] uppercase tracking-[0.16em] text-gray-400`}>{L.related}</p>
          <div class="flex flex-wrap gap-2.5">
            {related.map((r) => (
              <a href={r.href}
                class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 text-[13.5px] text-gray-600 transition-colors hover:border-gray-300 hover:text-gray-900">
                <span class="inline-block h-1.5 w-1.5 rounded-full" style={`background:${r.color}`}></span>
                {r.label}
              </a>
            ))}
          </div>
          <a href={BLOG_ROUTE} class={`${mono} mt-7 inline-block text-[12px] text-gray-400 transition-colors hover:text-gray-900`}>← {BLOG.navLabel}</a>
        </nav>
      </article>
    </main>
  </div>
</Layout>
